	<key>UIStatusBarHidden</key>
	<true/>
	<!-- Air Task 56: Starting with iPadOS 26, iPad defaults to windowed multitasking, and the system
	     can resize/move the SDLK window freely. The SDL3 path in MC 26.3 then calls requestGeometryUpdate
	     and treats geometry changes (Code=101) as "window minimized", triggering
	     SDL_EVENT_WINDOW_MINIMIZED(0x209) → onIconified(true) →
	     SurfaceException in GlSurface.acquireNextTexture → surface recreation →
	     EGL_BAD_ALLOC → black screen. Declaring that the app requires full screen prevents the system
	     from sending these geometry changes (iPhone does not support windowing and is unaffected; this
	     mainly protects iPad). Matches the Air launcher approach. -->
	<key>UIRequiresFullScreen</key>
	<true/>
